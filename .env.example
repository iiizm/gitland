# Copy this file to .env before refreshing live GitHub data.
# Never commit .env. Keep real tokens only in your local environment.

# Optional. Raises GitHub API limits for data collection.
GITHUB_TOKEN=

# Number of days to include in the generated history.
GITLAND_DAYS=90

# Repositories requested per topic query. GitHub search exposes up to 1,000
# results per query window, so 1000 is the practical maximum here.
GITLAND_PER_TOPIC=1000

# Output dataset used by the app.
GITLAND_OUT=src/github-data.json

# Repository event collection depth. Higher values improve activity accuracy
# but spend more API requests.
GITLAND_EVENT_REPOS_PER_TOPIC=1000
GITLAND_EVENT_PAGES=3
GITLAND_EVENT_CONCURRENCY=3
GITLAND_PAGE_DELAY_MS=120
